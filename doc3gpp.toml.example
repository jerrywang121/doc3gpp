# doc3gpp configuration file (TOML)
#
# This is a reference template. Copy it to one of:
#   - ./doc3gpp.toml       (project-local, checked into git)
#   - ~/.config/doc3gpp/config.toml  (user-wide)
# or point at any other location via the DOC3GPP_CONFIG env var.
#
# Precedence (highest wins):
#   1. CLI flags
#   2. Environment variables (DOC3GPP_*)
#   3. This file
#   4. Built-in defaults
#
# Run `doc3gpp config show` to inspect the resolved configuration,
# and `doc3gpp config path` to see which file is in effect.

# ── Database ─────────────────────────────────────────────────────────────────
# Mirrors the DOC3GPP_DATABASE_URL / DOC3GPP_DB_* env vars. Either layer
# works; env vars override this file when both are set.

# database_url = "sqlite+pysqlite:////home/you/.local/share/doc3gpp/doc3gpp.db"
# db_echo = false
# db_pool_size = 5
# db_auto_migrate = true

# ── HTTP scraping ───────────────────────────────────────────────────────────
# log_level = "INFO"            # DEBUG / INFO / WARNING / ERROR
# http_verify = false           # set true for TLS verification on older hosts
# http_max_retries = 3
# http_retry_backoff = 0.5      # seconds; doubles per attempt

# ── Fetch-side knobs for `doc3gpp meeting sync` ─────────────────────────────
# Both flags default to these values when not passed on the CLI.
# `closed_years`: keep meetings whose end_date is within this many years back.
# `future_years`: keep meetings whose start_date is within this many years ahead.

[meeting_sync]
closed_years = 2     # default; CLI flag --closed-years overrides
future_years = 1     # default; CLI flag --future-years overrides

# ── Output defaults for every `* list` command ──────────────────────────────
# `format` becomes the default for --format on meeting/tdoc/tsg/wi list.
# CLI flags --format and --fields always win over this file.
# The `fields.<command>` lists mirror the previously hardcoded defaults;
# trim them when the default columns are too noisy.

# [output]
# format = "table"     # table | json | markdown

# [output.fields]
# meeting = [
#   "meeting_id", "name", "tsg", "location",
#   "start_date", "end_date",
#   "ftp_url", "start_doc", "end_doc",
# ]
# tdoc = [
#   "tdoc_id", "meeting_name", "title",
#   "source", "type", "status",
#   "cr_cat", "spec", "version", "related_wis",
#   # "ftp_url" — relative path to the TDoc zip on https://www.3gpp.org/ftp/
# ]
# tsg = ["tsg_name", "short_name", "description"]
# wi = ["wi_id", "acronym", "release", "name"]

# ── TDoc extraction cache ───────────────────────────────────────────────────
# Disk cache for the TDoc extraction pipeline (`doc3gpp tdoc parse`).
# `dir` holds two subtrees: `zips/` (raw 3GPP downloads) and `markdown/`
# (python-docx output, keyed by content hash). When the combined size of
# both exceeds `size_limit_mb`, the cache evicts the oldest files first
# (FIFO on `st_ctime`); `0` means unlimited. `purge_confirm` gates the
# `doc3gpp cache purge` CLI behind an interactive prompt — set it to
# `false` (or pass `--yes`) to bypass the prompt in scripts.

# [cache]
# dir = "~/.cache/doc3gpp/tdocs"   # XDG default; created on first write
# size_limit_mb = 1024             # 0 = unlimited
# purge_confirm = true             # CLI guard for `doc3gpp cache purge`