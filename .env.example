# Copy to .env and adjust values as needed.
#
# The process-environment allowlist is below. The .env source is currently
# broader: recognized settings absent from TOML may also be populated here.
# Prefer TOML for other settings; see docs/config.md for exact precedence
# and src/doc3gpp/data/doc3gpp.toml.example for the full template.
#
# Recognised vars (see doc3gpp.settings.schema.ALLOWED_ENV_VARS):
#   DOC3GPP_DATABASE_URL, DOC3GPP_DB_ECHO, DOC3GPP_LOG_LEVEL,
#   DOC3GPP_HTTP_VERIFY, DOC3GPP_CACHE__DIR, DOC3GPP_SYNC__AUTO_SYNC,
#   DOC3GPP_TESTCASE_DATABASE_URL, DOC3GPP_SPECDATA_DATABASE_URL,
#   DOC3GPP_SEMANTIC_SEARCH__EMBEDDING_API_KEY,
#   DOC3GPP_WORD_CONVERSION__TIMEOUT_SECONDS

# DOC3GPP_DATABASE_URL: leave commented to use the default
#   sqlite+pysqlite:///<Path.home()>/.local/share/doc3gpp/doc3gpp.db
# DOC3GPP_DATABASE_URL=sqlite+pysqlite:////absolute/path/to/doc3gpp.db
DOC3GPP_DB_ECHO=false
DOC3GPP_HTTP_VERIFY=false
DOC3GPP_LOG_LEVEL=INFO

# Cache directory for the TDoc extraction pipeline
# (overrides the XDG default ~/.cache/doc3gpp/tdocs).
# DOC3GPP_CACHE__DIR=/path/to/cache

# When true, selected CLI reads and DB/direct `tdoc parse` modes may
# auto-sync first (not URL-keyed detail reads). Same skip rules apply.
# This example opts out; the application default without an override is true.
DOC3GPP_SYNC__AUTO_SYNC=false
