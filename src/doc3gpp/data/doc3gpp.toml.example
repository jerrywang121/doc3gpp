# doc3gpp configuration file (TOML)
#
# This is a reference template. Copy it to one of:
#   - ./doc3gpp.toml       (project-local, checked into git)
#   - ~/.config/doc3gpp/config.toml  (user-wide)
# or point at any other location via the DOC3GPP_CONFIG env var.
#
# Precedence (highest wins):
#   1. CLI flags
#   2. Environment variables — only the ALLOWED_ENV_VARS subset of
#      DOC3GPP_* (see src/doc3gpp/settings/schema.py). Anything else is
#      silently ignored, so this file is the single source of truth for
#      every other setting.
#   3. This file
#   4. Built-in defaults
#
# Run `doc3gpp config show` to inspect the resolved configuration,
# and `doc3gpp config path` to see which file is in effect.
# Or run `doc3gpp config init` to bootstrap a fresh config file (full defaults),
# then `doc3gpp config set <key> <value>` to edit individual keys.

# ── Database ─────────────────────────────────────────────────────────────────
# Mirrors the DOC3GPP_DATABASE_URL / DOC3GPP_DB_ECHO env vars. Either layer
# works; allowlisted env vars override this file when both are set.

# database_url = "sqlite+pysqlite:////home/you/.local/share/doc3gpp/doc3gpp.db"
# db_echo = false
# db_pool_size = 5
# db_auto_migrate = true

# ── HTTP scraping ───────────────────────────────────────────────────────────
# log_level = "INFO"            # DEBUG / INFO / WARNING / ERROR
# http_verify = false           # set true for TLS verification on older hosts
# http_max_retries = 3
# http_retry_backoff = 0.5      # seconds; doubles per attempt

# ── Output defaults for every `* list` command ──────────────────────────────
# `format` becomes the default for --format on meeting/tdoc/tsg/wi list.
# CLI flags --format and --fields always win over this file.
# The `fields.<command>` lists mirror the previously hardcoded defaults;
# trim them when the default columns are too noisy.

# [output]
# format = "table"     # table | json | markdown
# compact = false      # drop decorators in json/markdown output

# [output.fields]
# meeting = [
#   "meeting_id", "name", "tsg", "location",
#   "start_date", "end_date",
#   "ftp_url", "start_doc", "end_doc",
# ]
# tdoc = [
#   "tdoc_id", "meeting_name", "title",
#   "source", "type", "status",
#   "cr_cat", "spec", "version", "related_wis",
#   # "ftp_url" — relative path to the TDoc zip on https://www.3gpp.org/ftp/
# ]
# tsg = ["tsg_name", "short_name", "description"]
# wi = ["wi_id", "acronym", "release", "name"]

# ── TDoc extraction cache ───────────────────────────────────────────────────
# Disk cache for the TDoc extraction pipeline (`doc3gpp tdoc parse`).
# `dir` holds two subtrees: `zips/` (raw 3GPP downloads) and `markdown/`
# (python-docx output, keyed by content hash). When the combined size of
# both exceeds `size_limit_mb`, the cache evicts the oldest files first
# (FIFO on `st_ctime`); `0` means unlimited. `purge_confirm` gates the
# `doc3gpp cache purge` CLI behind an interactive prompt — set it to
# `false` (or pass `--yes`) to bypass the prompt in scripts.

# [cache]
# dir = "~/.cache/doc3gpp/tdocs"   # XDG default; created on first write
# size_limit_mb = 1024             # 0 = unlimited
# purge_confirm = true             # CLI guard for `doc3gpp cache purge`

# ── `tdoc parse` batch limit ────────────────────────────────────────────────
# Caps how many TDocs a single `tdoc parse` invocation will actually
# process when its filter set resolves to a larger candidate pool.
# Matches above the cap are truncated and reported as `Remaining` in
# the completion summary — re-run the same command without `--force`
# to pick up the next batch. Raise this for big-batch sweeps; lower it
# to keep confirmation prompts short.

# [tdoc_parse]
# max_batch = 100
# max_ftp_depth = 2  # max recursion depth for `tdoc parse --from-url <3gpp-folder> --recursive`
# max_tdoc_size_kb = 1000  # skip .zip/.docx larger than this; 0 = unlimited
# Extract the per-clause change-block list from the body of a
# non-TTCN CR. The extracted clauses and change blocks are stored
# in tdoc_cr_change_details (sidecar) and surfaced via tdoc show.
# body_change_enabled = true

# Max plain lines tolerated between two <ins>/<del> lines that
# still count as the same change block. 0 = consecutive only.
# body_change_gap_window = 2

# Plain context lines captured before and after each change block.
# 0 = no context, only marker lines + bridge.
# body_change_context_padding = 2
# Direct-parse flags (`--from-path`, `--from-url`, `--format`, `--output`)
# are CLI-only — no TOML equivalent is exposed for the
# `tdoc parse --from-*` direct mode.

# ── Sync intervals ──────────────────────────────────────────────────────────
# Gate how often `doc3gpp meeting sync` and `doc3gpp tdoc sync` re-scrape
# unchanged upstream data. Durations may be written as human strings (`24h`,
# `30m`, `90d`) or ISO 8601 durations (`P1D`, `PT30M`). Pass `--force` to
# either command to bypass the skip rules for a single invocation.

# [sync]
# auto_sync = true                # automatically sync before list/show/parse read commands
# meeting_sync_interval = "24h"   # skip meeting calendar sync if last sync is newer than this
# tdoc_list_sync_interval = "30m" # skip TDoc list sync if last sync is newer than this
# tdoc_list_closed_window = "90d" # skip TDoc list sync when meeting end_date is older than this
# tdoc_list_url_template = "https://portal.3gpp.org/ngppapp/GenerateDocumentList.aspx?meetingId={meeting_id}"

# ── Full-text search (FTS5) ─────────────────────────────────────────────────
# Full-text search (FTS5) subsystem knobs.
[search]
# Master switch for the search subsystem. False disables the CLI
# commands, the auto-index hook, and the tdoc_search DDL creation.
enabled = true

# When true, every successful tdoc parse calls
# SearchService.upsert_for_tdoc(tdoc_id) so the index stays in sync.
auto_index_on_parse = true

# TDocs per SQL page during `search index --rebuild`. Smaller
# values reduce the worst-case duplicate work on Ctrl-C
# (the cursor only advances per page); larger values save SQL
# round-trips. Progress is reported per TDoc via a tqdm bar
# regardless of this value.
rebuild_batch_size = 100

# Approximate number of tokens per FTS5 snippet(...) output. The
# CLI's --snippet-tokens flag overrides this for a single invocation.
snippet_tokens = 8

# Per-column BM25 weights passed to FTS5's bm25() ranking function
# and snippet() selection. Order MUST match the 8 indexed columns of
# the tdoc_search virtual table: (title, ftp_url, meeting_title,
# meeting_location, wis, cover_text, change_text, ttcn_text). A
# column with weight 0 is excluded from both ranking and previews; a
# column with weight > 0 gets its own highlighted snippet in query
# results (one per column, only when the snippet actually contains
# a match). Tune interactively via `doc3gpp search --explain`.
bm25_weights = [5.0, 0.0, 0.0, 1.0, 5.0, 5.0, 5.0, 5.0]

# When `search query --sem-query` is used, the FTS5 path fetches
# limit * search_fanout_factor candidates before the semantic
# reranker truncates back to limit. Higher values give the
# reranker more to work with at the cost of more vector lookups
# per query. Only honored when --sem-query is supplied.
search_fanout_factor = 4

# ── Semantic search (hybrid FTS5 + vector) ──────────────────────────────────
# Hybrid search subsystem: sentence-transformers embeddings + sqlite-vec
# KNN, fused with Reciprocal Rank Fusion (RRF) over the FTS5 + vector
# fan-out. Requires the `[semantic]` pyproject extra
# (`pip install "doc3gpp[semantic]"`) for the embedding model + the
# sqlite-vec extension. Schema is gated on the sqlite + sqlite-vec
# support matrix; on MySQL / PostgreSQL or when sqlite-vec is
# unavailable, only the FTS5 path is active and the vector path is a
# no-op.
#
# As of 2026-08-01 spaCy is no longer used: `search sem` embeds the
# natural-language positional QUERY only; supplying an FTS5 keyword
# query is opt-in via `--fts5-query`.

# [semantic_search]
# Master switch for the semantic search subsystem. False disables the
# `search sem` command, the auto-embed hook, and the
# `vec_tdoc_embeddings` DDL creation.
# enabled = true

# When true, every successful tdoc parse embeds the new content into
# the vector index so hybrid search sees the latest rows. Mirrors
# `[search].auto_index_on_parse`.
# auto_embed_on_parse = true

# Hugging Face model id used for embeddings. Must produce a vector
# dimension that matches the `vec_tdoc_embeddings` schema at creation
# time; changing this on a populated index requires
# `search index --rebuild-embeddings`.
# embedding_model = "sentence-transformers/all-MiniLM-L6-v2"

# Approximate chunk size in whitespace tokens passed to the text
# chunker. Each TDoc is split into windows of `chunk_size` whitespace
# tokens with `chunk_overlap` tokens of overlap to preserve context
# across boundaries. Mirrors `_chunks(text, size, overlap)` in
# `services/embedding/chunker.py`.
# chunk_size = 200

# Overlap between consecutive chunks (in whitespace tokens).
# chunk_overlap = 20

# RRF `k` constant. The blend is
#   rrf = 1/(k + rank_fts5) * (1 - W) + 1/(k + rank_vec) * W
# with `W = 1 - fts5_weight`. Larger `k` flattens the contribution of
# low-ranked candidates; smaller `k` sharpens the top.
# rrf_k = 60

# Default `--fts5-weight` for `search sem`. Range 0.0..1.0;
# the vector weight is `1 - fts5_weight`. 0.0 is pure vector;
# 1.0 is pure FTS5. Ignored when `--fts5-query` is omitted.
# fts5_weight = 0.5

# Fan-out multiplier for the hybrid FTS5 + vector paths of
# `search sem`. When `--fts5-query` is supplied, each side
# retrieves `fanout_multiplier * --limit` candidates before RRF
# merge and truncation. Ignored when `--fts5-query` is omitted
# (pure-vector path). Mirrors `search.search_fanout_factor` for
# `search query --sem-query`.
# fanout_multiplier = 4

# Hard cap on the number of chunks indexed per TDoc. Prevents
# pathological TDoc bodies from dominating the index.
# max_chunks_per_tdoc = 8
