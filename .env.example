# Copy to .env and adjust values as needed.
# DOC3GPP_DATABASE_URL: leave commented to use the default
#   sqlite+pysqlite:///<Path.home()>/.local/share/doc3gpp/doc3gpp.db
# DOC3GPP_DATABASE_URL=sqlite+pysqlite:////absolute/path/to/doc3gpp.db
DOC3GPP_DB_ECHO=false
DOC3GPP_DB_POOL_SIZE=5
DOC3GPP_DB_AUTO_MIGRATE=true
DOC3GPP_HTTP_VERIFY=false
DOC3GPP_HTTP_MAX_RETRIES=3
DOC3GPP_HTTP_RETRY_BACKOFF=0.5
DOC3GPP_LOG_LEVEL=INFO

# Nested settings can be overridden via the '__' delimiter, e.g.:
# DOC3GPP_MEETING_SYNC__CLOSED_YEARS=5
# DOC3GPP_OUTPUT__FORMAT=json
#
# For structured config (TOML), see doc3gpp.toml.example and the
# `doc3gpp config path` / `doc3gpp config show` commands.
